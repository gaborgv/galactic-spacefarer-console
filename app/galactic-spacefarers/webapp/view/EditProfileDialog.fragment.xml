<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog title="Edit Profile" contentWidth="32rem">
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" width="100%">
      <Label text="Name" required="true" />
      <Input id="editName" value="{profile>/name}" />

      <Label text="Stardust Collection" required="true" />
      <Input id="editStardust" value="{profile>/stardustCollection}" type="Number" />

      <Label text="Spacesuit Color" required="true" />
      <Select id="editColor" selectedKey="{profile>/spacesuitColor_code}" items="{profile>/colors}">
        <core:Item key="{profile>code}" text="{profile>name}" />
      </Select>

      <Label text="Navigation Skill" required="true" />
      <Select id="editSkill" selectedKey="{profile>/navigationSkill_level}" items="{profile>/skills}">
        <core:Item key="{profile>level}" text="{profile>name}" />
      </Select>

      <Label text="Department" required="true" />
      <Select
        id="editDepartment"
        selectedKey="{profile>/department_ID}"
        items="{profile>/departments}"
        change=".onEditDepartmentChange">
        <core:Item key="{profile>ID}" text="{profile>code}" />
      </Select>

      <Label text="Position" required="true" />
      <Select id="editPosition" selectedKey="{profile>/position_ID}" items="{profile>/positions}">
        <core:Item key="{profile>ID}" text="{profile>code}" />
      </Select>
    </f:SimpleForm>
    <beginButton>
      <Button text="Save" type="Emphasized" press=".onEditProfileSave" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onEditProfileCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
