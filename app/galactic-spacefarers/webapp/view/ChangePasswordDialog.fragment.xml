<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form">
  <Dialog title="Change Password" type="Message">
    <f:SimpleForm editable="true" layout="ResponsiveGridLayout" width="100%">
      <Label text="Current Password" />
      <Input id="oldPassword" type="Password" />
      <Label text="New Password" />
      <Input id="newPassword" type="Password" />
      <Label text="Confirm New Password" />
      <Input id="confirmPassword" type="Password" />
    </f:SimpleForm>
    <beginButton>
      <Button text="Update" type="Emphasized" press=".onPasswordDialogConfirm" />
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onPasswordDialogCancel" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
