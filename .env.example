# Galactic Console — local development baseline
# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# CAP loads .env automatically when present (see .gitignore — never commit .env).

# --- CAP runtime (optional) ---
# CDS_ENV=development
# Port for `npm run watch` (CAP default: 4004)
# PORT=4004

# --- Account lockout (srv/lib/lockout.js) ---
# Failed logins before the account is locked
GALACTIC_LOCKOUT_MAX_ATTEMPTS=5
# Lockout duration in minutes
GALACTIC_LOCKOUT_DURATION_MINUTES=15

# --- Rate limiting (srv/lib/throttle.js) ---
# Max requests per IP per window on register and resetPassword
GALACTIC_RATE_LIMIT_MAX=2000
# Max failed login attempts per IP per window before 429
GALACTIC_AUTH_FAIL_LIMIT=500
# Rate-limit window in milliseconds
GALACTIC_RATE_LIMIT_WINDOW_MS=60000
# How long a successful Basic Auth is cached (avoids bcrypt on every OData call)
GALACTIC_AUTH_CACHE_TTL_MS=600000

# --- Stardust limits (srv/lib/config.js, srv/lib/validators.js) ---
# Maximum stardust collection (validation + post-bonus cap)
GALACTIC_STARDUST_MAX=999999

# --- Onboarding bonuses (srv/lib/onboarding.js) ---
# Comma-separated department codes that receive the extra +200 stardust signup bonus
# (all recruits still get the base +100)
GALACTIC_BONUS_DEPARTMENT_CODES=ENG
